@page "/"
@inject PostStore Store

<h2>posts</h2>
<p class="dim">runs in the browser (WebAssembly). list is in this tab only.</p>

@if (Store.All().Count == 0)
{
    <p class="dim">empty</p>
}
else
{
    @foreach (Post post in Store.All())
    {
        <div class="item"><b>@post.Title</b> @post.Content</div>
    }
}

<div class="box">
    <input @bind="title" placeholder="title" />
    <input @bind="content" placeholder="content" />
    <button @onclick="Add">add</button>
</div>

@code {
    private string title = "";
    private string content = "";

    private void Add()
    {
        Store.Add(new Post { Title = title, Content = content });
        title = "";
        content = "";
    }
}
