{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=app.db"
  },
  "Cookies": {
    "Auth": {
      "Name": "MvcAuth",
      "LoginPath": "/Account/Login",
      "AccessDeniedPath": "/Account/Denied",
      "ExpireHours": 8,
      "SlidingExpiration": true,
      "HttpOnly": true,
      "SameSite": "Lax",
      "SecurePolicy": "SameAsRequest",
      "RememberMeDays": 30
    },
    "OpenNote": {
      "Name": "open_note",
      "Hours": 1,
      "HttpOnly": false,
      "SameSite": "Lax"
    }
  },
  "Jwt": {
    "Issuer": "MvcAuthApp",
    "Audience": "MvcAuthApp.Api",
    "Key": "classroom-only-not-a-real-secret-32",
    "LifetimeMinutes": 60
  }
}
