@model PostForm
@{
    ViewData["Title"] = "Edit";
}

<h2>Edit post</h2>
<p class="muted">Resource-based: the author or an Admin. Checked with <code>IAuthorizationService</code> after the row is loaded.</p>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <label>Title</label>
    <input asp-for="Title" />
    <label>Content</label>
    <textarea asp-for="Content"></textarea>
    <button class="btn-go" type="submit">Save</button>
</form>
<p><a asp-action="Index">Back</a></p>
