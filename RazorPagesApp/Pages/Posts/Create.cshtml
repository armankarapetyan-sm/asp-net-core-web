@page
@model RazorPagesApp.Pages.Posts.CreateModel
@{
    ViewData["Title"] = "Create";
}

<h2>Create</h2>
<form method="post">
    <div class="field">
        <label asp-for="Post.Title">Title</label>
        <input asp-for="Post.Title" />
    </div>
    <div class="field">
        <label asp-for="Post.Content">Content</label>
        <textarea asp-for="Post.Content"></textarea>
    </div>
    <button class="go" type="submit">Save</button>
</form>
<p><a asp-page="/Posts/Index">Back</a></p>
