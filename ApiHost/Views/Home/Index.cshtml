@model IReadOnlyList<Post>
@{
    ViewData["Title"] = "Home";
}

<h2>HTML next to JSON</h2>
<p>Same process as <code>/api/posts</code>.</p>
@if (Model.Count == 0)
{
    <p>No rows.</p>
}
else
{
    <table class="tbl">
        <tr><th>Title</th><th>Content</th></tr>
        @foreach (Post post in Model)
        {
            <tr>
                <td>@post.Title</td>
                <td>@post.Content</td>
            </tr>
        }
    </table>
}
